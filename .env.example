# Copy to .env and fill in. .env is gitignored and never committed.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model overrides. Each line shows the default from inside_joke/config.py.
# Leave them commented out to use the defaults. config.py reads OPENROUTER_API_KEY
# from this file directly; the IJ_* overrides come from the environment. `make run`
# and `make serve` export everything in .env, or run: set -a; . ./.env; set +a
# Writes the 3 candidate concepts.
# IJ_WRITER=anthropic/claude-sonnet-5.5
# Writer used with --fast.
# IJ_WRITER_FAST=anthropic/claude-haiku-5.5
# Judge. Keep it a different model family from the writer.
# IJ_JUDGE=google/gemini-3.6-flash
# Draws SVG art when image credit is unavailable or --art svg is set.
# IJ_SVG=anthropic/claude-sonnet-5.5
# Raster image model (OpenRouter needs at least $1 balance for image output).
# IJ_IMAGE=google/gemini-3.1-flash-image
# IJ_IMAGE_FALLBACK=google/gemini-3.1-flash-lite-image
